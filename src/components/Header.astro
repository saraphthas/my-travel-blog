
---
import { SITE_TITLE } from '../consts';
---

<header class="site-header" data-page={Astro.url.pathname === '/' ? 'home' : 'other'}>
  <a class="logo" href="/" aria-label={`${SITE_TITLE} home`}>
  </a>

  <button
    class="menu-toggle"
    aria-label="Open navigation"
    aria-expanded="false"
    aria-controls="main-navigation"
  >
    <span></span>
    <span></span>
  </button>

  <nav id="main-navigation" aria-label="Main navigation">
    <a class="nav-link" href="/">Home</a>

    <div class="dropdown">
      <button
        class="drop-btn"
        aria-haspopup="true"
        aria-expanded="false"
      >
        Destinations
        <span class="chevron" aria-hidden="true">⌄</span>
      </button>

      <div class="menu">
        <a href="/blog">Europe <span>↗</span></a>
        <a href="/blog">Asia <span>↗</span></a>
        <a href="/blog">Americas <span>↗</span></a>
        <a href="/blog">Africa <span>↗</span></a>
      </div>
    </div>

    <a class="nav-link" href="/blog">Journal</a>
    <a class="nav-link" href="/about">About</a>

   
  </nav>
</header>

<script>
  const header = document.querySelector('.site-header');

  if (header) {
    const toggle = header.querySelector('.menu-toggle');
    const nav = header.querySelector('#main-navigation');
    const destinationButton = header.querySelector('.drop-btn');
    const dropdown = header.querySelector('.dropdown');

    const closeMenu = () => {
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open navigation');
      nav?.classList.remove('is-open');
      destinationButton?.setAttribute('aria-expanded', 'false');
      dropdown?.classList.remove('is-open');
    };

    toggle?.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';

      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute(
        'aria-label',
        isOpen ? 'Open navigation' : 'Close navigation'
      );
      nav?.classList.toggle('is-open', !isOpen);
    });

    destinationButton?.addEventListener('click', () => {
      const isOpen =
        destinationButton.getAttribute('aria-expanded') === 'true';

      destinationButton.setAttribute('aria-expanded', String(!isOpen));
      dropdown?.classList.toggle('is-open', !isOpen);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });

    nav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) {
        closeMenu();
      }
    });
  }
</script>

<style>
  :global(:root) {
    --forest: #343b31;
    --sage: #69715d;
    --moss: #b7c4a5;
    --cream: #f5f3ed;
    --ink: #292d27;
  }

  .site-header {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      box-sizing: border-box;
      z-index: 100;

      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      padding: 1.1rem clamp(1.25rem, 5vw, 4.5rem);

      background: transparent;
      border-bottom: none;
  }

  /* Default: black navigation on other pages */
  .site-header[data-page='other'] .logo,
  .site-header[data-page='other'] .nav-link,
  .site-header[data-page='other'] .drop-btn {
    color: #000;
  }

  /* Homepage: white navigation over the hero image */
  .site-header[data-page='home'] .logo,
  .site-header[data-page='home'] .nav-link,
  .site-header[data-page='home'] .drop-btn {
    color: #fffdf8;
  }

  .site-header .logo-mark {
    color: #d5dfc7;
  }

  .site-header .nav-cta {
    background: #fffdf8;
    border-color: #fffdf8;
    color: var(--forest);
  }

  .site-header .menu-toggle {
    border-color: rgba(255, 255, 255, 0.6);
  }

  .site-header .menu-toggle span {
    background: #fffdf8;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--forest);
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    text-decoration: none;
    white-space: nowrap;
  }

  .logo-mark {
    color: var(--sage);
    font-family: 'DM Sans', sans-serif;
    font-size: 1.45rem;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.3vw, 2rem);
  }

  
    .nav-link,
    .drop-btn {
      position: relative;
      padding: 0.5rem 0;
      color: var(--forest);
      font-family: 'DM Sans', sans-serif;
      font-size: 1rem;
      font-weight: 500;
      text-decoration: none;
      transition: opacity 0.25s ease, transform 0.25s ease;
    }


    .nav-link::after,
    .drop-btn::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: 2px;
      width: 100%;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s ease;
    }

    .nav-link:hover,
    .drop-btn:hover {
      opacity: 0.8;
      transform: translateY(-2px);
    }

    .nav-link:hover::after,
    .drop-btn:hover::after {
      transform: scaleX(1);
    }

  .dropdown {
    position: relative;
  }

  .drop-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .chevron {
    font-size: 1rem;
    transition: transform 0.2s ease;
  }

  .dropdown:hover .chevron,
  .dropdown:focus-within .chevron,
  .dropdown.is-open .chevron {
    transform: rotate(180deg);
  }

  .menu {
    position: absolute;
    top: calc(100% + 0.65rem);
    left: -1rem;
    display: none;
    min-width: 190px;
    padding: 0.55rem;
    border: 1px solid rgba(52, 59, 49, 0.09);
    border-radius: 10px;
    background: #fffdf8;
    box-shadow: 0 14px 35px rgba(35, 43, 32, 0.12);
  }

  .dropdown:hover .menu,
  .dropdown:focus-within .menu,
  .dropdown.is-open .menu {
    display: block;
  }

  .menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.85rem;
    border-radius: 6px;
    color: var(--forest);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    text-decoration: none;
  }

  .menu a span {
    color: var(--sage);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .menu a:hover {
    background: var(--cream);
  }

  .menu a:hover span {
    opacity: 1;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--forest);
    border-radius: 999px;
    background: var(--forest);
    color: var(--cream);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nav-cta:hover {
    background: transparent;
    color: var(--forest);
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 760px) {
    .site-header {
      flex-wrap: wrap;
      gap: 0;
      padding: 1rem 1.25rem;
    }

    .logo {
      max-width: calc(100% - 4rem);
      white-space: normal;
    }

    .menu-toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      width: 44px;
      height: 44px;
      padding: 10px;
      border: 1px solid rgba(52, 59, 49, 0.2);
      border-radius: 50%;
      background: transparent;
      cursor: pointer;
    }

    .menu-toggle span {
      display: block;
      width: 100%;
      height: 1.5px;
      background: var(--forest);
      transition: transform 0.2s ease;
    }

    .menu-toggle[aria-expanded='true'] span:first-child {
      transform: translateY(3.75px) rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] span:last-child {
      transform: translateY(-3.75px) rotate(-45deg);
    }

    nav {
      display: none;
      flex: 0 0 100%;
      align-items: stretch;
      flex-direction: column;
      gap: 0.25rem;
      padding: 1rem 0 0.25rem;
    }

    nav.is-open {
      display: flex;
    }

    .nav-link,
    .drop-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      box-sizing: border-box;
      padding: 0.85rem 0.25rem;
      text-align: left;
    }

    .menu {
      position: static;
      min-width: 0;
      margin: 0 0 0.5rem;
      border: 0;
      border-radius: 8px;
      background: rgba(105, 113, 93, 0.08);
      box-shadow: none;
    }

    .menu a span {
      opacity: 1;
    }

    .nav-cta {
      justify-content: center;
      margin-top: 0.75rem;
      padding: 0.9rem 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition: none !important;
    }
  }
</style>