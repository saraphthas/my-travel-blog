\---
// PhotoScroll.astro
// Put this in src/components/ and add <PhotoScroll /> AFTER </article> in your blog post layout.
// It reads <div class="photo-moment" ...></div> markers from the post's Markdown.
---

<!-- Fixed layer behind the text where the taped photos fade in and out -->
<div id="photo-stage" aria-hidden="true"></div>

<!-- Gallery (stays hidden until the post has photos) -->
<section id="gallery" class="gallery" hidden>
	<h2>Gallery</h2>
	<div class="gallery-viewport">
		<div id="gallery-track" class="gallery-track"></div>
	</div>
	<div id="gallery-controls" class="gallery-controls" hidden>
		<button type="button" id="gallery-prev" class="gallery-nav" aria-label="Previous photos">‹</button>
		<span id="gallery-count" class="gallery-count" aria-live="polite"></span>
		<button type="button" id="gallery-next" class="gallery-nav" aria-label="Next photos">›</button>
	</div>
</section>

<!-- Full-screen viewer -->
<dialog id="lightbox" class="lightbox" aria-label="Photo viewer">
	<button type="button" class="lb-btn lb-prev" aria-label="Previous photo">‹</button>
	<figure>
		<img alt="" />
		<figcaption></figcaption>
	</figure>
	<button type="button" class="lb-btn lb-next" aria-label="Next photo">›</button>
</dialog>

<style is:global>
	/* ---------- Taped photos behind the text ---------- */
	#photo-stage {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
		/* side space beside the text column, plus a little tuck behind it */
		--room: calc((100vw - 720px) / 2 + 40px);
		--tape-sage: rgba(168, 182, 148, 0.82);
		--tape-kraft: rgba(222, 203, 164, 0.88);
	}

	#photo-stage .snap {
		--x: var(--dx, 2vw);
		position: absolute;
		top: var(--top, 50%);
		width: var(--w);
		margin: 0;
		padding: 9px;
		background: #fffdf8;
		box-shadow:
			0 1px 2px rgba(40, 45, 35, 0.2),
			0 16px 32px -8px rgba(40, 45, 35, 0.28);
		opacity: 0;
		will-change: opacity, transform;
	}

	#photo-stage .left {
		left: var(--x);
	}

	#photo-stage .right {
		right: var(--x);
	}

	/* Three sizes, kept inside the side margins on narrower screens */
	#photo-stage .size-s {
		--w: min(clamp(150px, 15vw, 230px), var(--room));
	}
	#photo-stage .size-m {
		--w: min(clamp(180px, 20vw, 300px), var(--room));
	}
	#photo-stage .size-l {
		--w: min(clamp(210px, 26vw, 390px), var(--room));
	}

	#photo-stage .snap img {
		display: block;
		margin: 0;
		border-radius: 0;
		width: 100%;
		height: auto;
		max-height: 52vh;
		object-fit: cover;
	}

	#photo-stage .snap figcaption {
		margin: 0;
		padding-top: 10px;
		color: #5b6150;
		font-family: 'Caveat', 'Bradley Hand', 'Segoe Print', cursive;
		font-size: 22px;
		line-height: 1.2;
		text-align: center;
	}

	/* Washi tape: a strip across the top, or two taped corners */
	#photo-stage .snap::before,
	#photo-stage .snap::after {
		position: absolute;
		z-index: 1;
		content: none;
		clip-path: polygon(0 0, 4% 15%, 0 30%, 4% 45%, 0 60%, 4% 75%, 0 100%, 100% 100%, 96% 85%, 100% 70%, 96% 55%, 100% 40%, 96% 25%, 100% 0);
	}

	#photo-stage .tape-a::before {
		content: '';
		top: -13px;
		left: 50%;
		width: 88px;
		height: 26px;
		transform: translateX(-50%) rotate(-3deg);
		background:
			repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.22) 0 6px, transparent 6px 12px),
			var(--tape-sage);
	}

	#photo-stage .tape-b::before,
	#photo-stage .tape-b::after {
		content: '';
		top: -6px;
		width: 66px;
		height: 22px;
		background: var(--tape-kraft);
	}

	#photo-stage .tape-b::before {
		left: -24px;
		transform: rotate(-38deg);
	}

	#photo-stage .tape-b::after {
		right: -24px;
		transform: rotate(38deg);
	}

	/* Phones and small tablets: smaller photos peeking in from the edges,
	   faint enough that the text stays easy to read */
	@media (max-width: 900px) {
		#photo-stage .snap {
			--x: -5vw;
		}
		#photo-stage .size-s {
			--w: 34vw;
		}
		#photo-stage .size-m {
			--w: 42vw;
		}
		#photo-stage .size-l {
			--w: 50vw;
		}
		#photo-stage .snap img {
			max-height: 34vh;
		}
		#photo-stage .snap figcaption {
			font-size: 18px;
		}
	}

	/* Markers in the Markdown take up no space */
	.photo-moment {
		display: block;
		height: 0;
	}

	/* ---------- Gallery: a journal spread ---------- */
	.gallery {
		position: relative;
		z-index: 1;
		max-width: 1100px;
		margin: 96px auto 0;
	}

	#gallery[hidden] {
		display: none;
	}

	.gallery h2 {
		margin: 0 0 40px;
		color: #343b31;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: clamp(32px, 4vw, 44px);
		font-weight: 500;
		letter-spacing: -0.03em;
		text-align: center;
	}

	.gallery {
		max-width: 900px;
	}

	/* Sliding gallery: pages of 3 columns x 2 rows sit side by side in a track */
	.gallery-viewport {
		overflow: hidden;
		/* breathing room so tilted prints and tape are not clipped */
		padding: 22px 14px 18px;
	}

	.gallery-track {
		display: flex;
		transition: transform 0.55s cubic-bezier(0.22, 0.7, 0.2, 1);
	}

	.gallery-page {
		display: grid;
		flex: 0 0 100%;
		grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
		grid-template-rows: repeat(2, auto);
		gap: 22px 16px;
		box-sizing: border-box;
		align-content: start;
	}

	.gallery-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		margin-top: 18px;
	}

	.gallery-controls[hidden] {
		display: none;
	}

	.gallery-nav {
		display: grid;
		width: 46px;
		height: 46px;
		place-items: center;
		padding: 0 0 4px;
		border: 1px solid #b7c4a5;
		border-radius: 50%;
		background: #fffdf8;
		color: #343b31;
		font-size: 26px;
		line-height: 1;
		cursor: pointer;
		transition:
			background 0.2s ease,
			color 0.2s ease,
			opacity 0.2s ease;
	}

	.gallery-nav:hover:not(:disabled) {
		background: #343b31;
		color: #fffdf7;
	}

	.gallery-nav:disabled {
		opacity: 0.35;
		cursor: default;
	}

	.gallery-nav:focus-visible {
		outline: 2px solid #69715d;
		outline-offset: 3px;
	}

	.gallery-count {
		min-width: 64px;
		color: #5b6150;
		font-family: 'DM Sans', sans-serif;
		font-size: 14px;
		letter-spacing: 0.04em;
		text-align: center;
	}

	.gallery-item {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 1 / 1;
		box-sizing: border-box;
		margin: 0;
		padding: 7px;
		border: 0;
		background: #fffdf8;
		box-shadow:
			0 1px 2px rgba(40, 45, 35, 0.18),
			0 12px 24px -8px rgba(40, 45, 35, 0.26);
		cursor: zoom-in;
		transform: rotate(var(--r, 0deg));
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}

	.gallery-item:nth-child(3n + 1) {
		--r: -1.6deg;
	}
	.gallery-item:nth-child(3n + 2) {
		--r: 1.2deg;
	}
	.gallery-item:nth-child(3n) {
		--r: -0.6deg;
	}

	.gallery-item:nth-child(odd)::before {
		content: '';
		position: absolute;
		top: -11px;
		left: 50%;
		width: 74px;
		height: 22px;
		transform: translateX(-50%) rotate(-2deg);
		background:
			repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.22) 0 6px, transparent 6px 12px),
			rgba(168, 182, 148, 0.82);
		clip-path: polygon(0 0, 4% 15%, 0 30%, 4% 45%, 0 60%, 4% 75%, 0 100%, 100% 100%, 96% 85%, 100% 70%, 96% 55%, 100% 40%, 96% 25%, 100% 0);
	}

	.gallery-item:hover,
	.gallery-item:focus-visible {
		transform: rotate(0deg) scale(1.02);
		box-shadow:
			0 1px 2px rgba(40, 45, 35, 0.18),
			0 18px 32px -8px rgba(40, 45, 35, 0.32);
	}

	#gallery .gallery-item img {
		display: block;
		margin: 0;
		border-radius: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.gallery-item:focus-visible,
	.lb-btn:focus-visible {
		outline: 2px solid #69715d;
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery-item,
		.gallery-track,
		.gallery-nav {
			transition: none;
		}
	}

	/* ---------- Lightbox ---------- */
	.lightbox {
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		padding: 0;
		border: 0;
		background: transparent;
	}

	.lightbox[open] {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
	}

	.lightbox::backdrop {
		background: rgba(30, 35, 28, 0.92);
	}

	.lightbox figure {
		margin: 0;
		text-align: center;
	}

	.lightbox img {
		max-width: min(86vw, 1200px);
		max-height: 80vh;
		border-radius: 10px;
	}

	.lightbox figcaption {
		margin-top: 12px;
		color: #e0e5d6;
		font-family: 'DM Sans', sans-serif;
		font-size: 14px;
	}

	.lb-btn {
		padding: 0 12px;
		border: 0;
		background: none;
		color: #fffdf7;
		font-size: 56px;
		line-height: 1;
		cursor: pointer;
	}

	@media (max-width: 640px) {
		.lb-btn {
			font-size: 40px;
			padding: 0 4px;
		}
	}
</style>

<script>
	// @ts-nocheck
	const stage = document.getElementById('photo-stage');
	const gallery = document.getElementById('gallery');
	const dialog = document.getElementById('lightbox');

	const markers = [...document.querySelectorAll('.photo-moment')];
	const photos = []; // every photo, for the gallery and viewer
	const moments = []; // photos that also fade in behind the text

	// Each photo takes the next "look" in these lists so no two neighbours match.
	// Override any of them per photo with data-tilt, data-size, data-side.
	const TILTS = [-4, 3, -2, 5, -5, 2]; // degrees
	const SIZES = ['m', 'l', 's', 'l', 'm', 's'];
	const TOPS = [40, 58, 46, 36, 56, 48]; // % down the screen
	const OFFSETS = [2, 4.5, 1.5, 5, 3, 1]; // vw in from the screen edge

	markers.forEach((marker) => {
		const src = marker.dataset.src;
		if (!src) return;
		const caption = marker.dataset.caption || '';
		// >>> CHANGED: data-gallery="false" keeps a photo OUT of the gallery (scroll only) <<<
		if (marker.dataset.gallery !== 'false') photos.push({ src, caption });

		// data-stage="false" puts a photo in the gallery only
		if (marker.dataset.stage === 'false') return;

		const n = moments.length;
		const side = marker.dataset.side || (n % 2 === 0 ? 'left' : 'right');
		const tilt = marker.dataset.tilt !== undefined ? Number(marker.dataset.tilt) : TILTS[n % TILTS.length];
		const size = ['s', 'm', 'l'].includes(marker.dataset.size) ? marker.dataset.size : SIZES[n % SIZES.length];
		const tape = n % 2 === 0 ? 'tape-a' : 'tape-b';

		const el = document.createElement('figure');
		el.className = `snap ${side === 'right' ? 'right' : 'left'} size-${size} ${tape}`;
		el.style.setProperty('--top', `${TOPS[n % TOPS.length]}%`);
		el.style.setProperty('--dx', `${OFFSETS[n % OFFSETS.length]}vw`);

		const img = document.createElement('img');
		img.src = src;
		img.alt = '';
		img.decoding = 'async';
		el.appendChild(img);

		if (caption) {
			const cap = document.createElement('figcaption');
			cap.textContent = caption;
			el.appendChild(cap);
		}

		stage.appendChild(el);
		moments.push({ marker, el, tilt });
	});

	// ---------- Scroll effect ----------
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const smallScreen = window.matchMedia('(max-width: 900px)');
	const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v));
	let ticking = false;

	// >>> CHANGED: easy timing controls (all measured in screen heights) <<<
	const APPEAR_AT = 0.8; // photo starts fading in when its marker is this far down the screen (1 = bottom edge)
	const FADE_IN = 0.25; // how long the fade-in takes
	const STAY_UNTIL = -0.05; // photo starts fading out when the marker is this far up (0 = top edge, negative = above it)
	const FADE_OUT = 0.25; // how long the fade-out takes

	function update() {
		const vh = window.innerHeight;
		const peak = smallScreen.matches ? 0.3 : 0.95;

		for (const { marker, el, tilt } of moments) {
			// y = where the marker sits in the viewport: 1 = bottom edge, 0 = top edge
			const y = marker.getBoundingClientRect().top / vh;

			// >>> CHANGED: uses the timing controls above <<<
			const fadeIn = clamp((APPEAR_AT - y) / FADE_IN, 0, 1);
			const fadeOut = clamp((y - (STAY_UNTIL - FADE_OUT)) / FADE_OUT, 0, 1);
			const visible = Math.min(fadeIn, fadeOut);
			el.style.opacity = String(visible * peak);

			const drift = reduceMotion ? 0 : y * 60; // gentle parallax
			const turn = reduceMotion ? tilt : tilt + y * 2; // sways a touch as you scroll
			const scale = reduceMotion ? 1 : 0.94 + 0.06 * visible; // settles into place
			el.style.transform = `translateY(-50%) translateY(${drift}px) rotate(${turn}deg) scale(${scale})`;
		}
		ticking = false;
	}

	window.addEventListener(
		'scroll',
		() => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		},
		{ passive: true }
	);
	window.addEventListener('resize', update);
	update();

	// ---------- Gallery and viewer ----------
	if (photos.length > 0) {
		gallery.hidden = false;

		const viewerImg = dialog.querySelector('img');
		const viewerCaption = dialog.querySelector('figcaption');
		let current = 0;

		function show(i) {
			current = (i + photos.length) % photos.length;
			viewerImg.src = photos[current].src;
			viewerImg.alt = photos[current].caption;
			viewerCaption.textContent = photos[current].caption;
		}

		// ---- Sliding gallery: 2 rows per page, 3 columns (2 on phones) ----
		const track = document.getElementById('gallery-track');
		const controls = document.getElementById('gallery-controls');
		const prevBtn = document.getElementById('gallery-prev');
		const nextBtn = document.getElementById('gallery-next');
		const countEl = document.getElementById('gallery-count');
		const medium = window.matchMedia('(min-width: 640px)');

		let page = 0;
		let pageCount = 1;
		let perPage = 6;
		let cols = 3;

		const makeItem = (photo, i) => {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'gallery-item';
			button.setAttribute('aria-label', photo.caption || `Open photo ${i + 1}`);

			const img = document.createElement('img');
			img.src = photo.src;
			img.alt = photo.caption;
			img.loading = 'lazy';

			button.appendChild(img);
			button.addEventListener('click', () => {
				show(i);
				dialog.showModal();
			});
			return button;
		};

		function goTo(n) {
			page = Math.min(pageCount - 1, Math.max(0, n));
			track.style.transform = `translateX(-${page * 100}%)`;
			prevBtn.disabled = page === 0;
			nextBtn.disabled = page === pageCount - 1;
			countEl.textContent = `${page + 1} / ${pageCount}`;

			// only the visible page is reachable by keyboard and screen readers
			[...track.children].forEach((p, idx) => {
				if (idx === page) p.removeAttribute('inert');
				else p.setAttribute('inert', '');
			});
		}

		function buildGallery() {
			// keep the same photos in view when the screen size changes
			const firstShown = page * perPage;

			cols = medium.matches ? 3 : 2;
			perPage = cols * 2;
			pageCount = Math.max(1, Math.ceil(photos.length / perPage));

			track.replaceChildren();
			for (let p = 0; p < pageCount; p++) {
				const pageEl = document.createElement('div');
				pageEl.className = 'gallery-page';
				pageEl.style.setProperty('--cols', String(cols));
				photos.slice(p * perPage, (p + 1) * perPage).forEach((photo, k) => {
					pageEl.appendChild(makeItem(photo, p * perPage + k));
				});
				track.appendChild(pageEl);
			}

			controls.hidden = pageCount < 2;
			goTo(Math.floor(firstShown / perPage));
		}

		prevBtn.addEventListener('click', () => goTo(page - 1));
		nextBtn.addEventListener('click', () => goTo(page + 1));
		medium.addEventListener('change', buildGallery);
		buildGallery();

		dialog.querySelector('.lb-prev').addEventListener('click', (e) => {
			e.stopPropagation();
			show(current - 1);
		});
		dialog.querySelector('.lb-next').addEventListener('click', (e) => {
			e.stopPropagation();
			show(current + 1);
		});
		dialog.addEventListener('click', () => dialog.close());
		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') show(current - 1);
			if (e.key === 'ArrowRight') show(current + 1);
		});
	}
</script>