
---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latest = posts.slice(0, 7);
---


<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

    <style>
      :root {
        --forest: #343b31;
        --sage: #69715d;
        --moss: #b7c4a5;
        --cream:rgb(244, 237, 224);
        --paper: #fffdf8;
        --ink: #292d27;
        --muted: #74766d;
        --font-heading: 'Playfair Display', Georgia, serif;
        --font-body: 'DM Sans', sans-serif;
      }

      :global(html) {
        scroll-behavior: smooth;
        background: var(--cream);
      }

      :global(body) {
        margin: 0;
        background: var(--cream);
        color: var(--ink);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
      }

      /* HERO */

      .hero {
        position: relative;
        isolation: isolate;
        min-height: 85svh;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 7rem 1.5rem;
        text-align: center;

        background:
          linear-gradient(
            180deg,
            rgba(25, 32, 24, 0.25) 0%,
            rgba(25, 32, 24, 0.4) 50%,
            rgba(25, 32, 24, 0.65) 100%
          ),
          url('/homepage2.jpg') center / cover no-repeat;
      }

      .eyebrow {
        margin: 0 0 1.5rem;
        color: #e0e5d6;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        line-height: 1.6;
        text-transform: uppercase;
      }

      .hero h1 {
        max-width: 1000px;
        margin: 0 0 1.5rem;
        color: #fffdf7;
        font-family: var(--font-heading);
        font-size: clamp(3.2rem, 8vw, 7rem);
        font-weight: 400;
        line-height: 1.04;
        letter-spacing: -0.045em;
        text-wrap: balance;
      }

      .hero p {
        max-width: 540px;
        margin: 0 auto 2.5rem;
        color: rgba(255, 253, 247, 0.92);
        font-size: clamp(1rem, 2vw, 1.15rem);
        line-height: 1.9;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1rem 1.7rem;
        border: 1px solid var(--cream);
        border-radius: 999px;
        background: var(--cream);
        color: var(--forest);
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        transition:
          background 0.25s ease,
          color 0.25s ease,
          transform 0.25s ease;
      }

      .btn:hover {
        transform: translateY(-2px);
        background: transparent;
        color: white;
      }

      .hero-note {
        position: absolute;
        right: clamp(1.25rem, 4vw, 3rem);
        bottom: 1.75rem;
        margin: 0;
        color: rgba(255, 253, 247, 0.8);
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      /* LATEST STORIES */

      .wrap {
        max-width: 1240px;
        margin: 0 auto;
        padding: 6rem 2rem 7rem;
      }

      .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
      }

      .section-label {
        margin: 0 0 0.8rem;
        color: var(--sage);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .section-heading h2 {
        margin: 0;
        color: var(--forest);
        font-family: var(--font-heading);
        font-size: clamp(2.3rem, 5vw, 3.7rem);
        font-weight: 400;
        letter-spacing: -0.04em;
        line-height: 1.1;
      }

      .all-stories {
        flex-shrink: 0;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid var(--moss);
        color: var(--forest);
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .all-stories:hover {
        color: var(--sage);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2.5rem 1.5rem;
      }

      .card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        border-radius: 5px;
        background: var(--paper);
        color: inherit;
        text-decoration: none;
        box-shadow: 0 4px 24px rgba(36, 42, 33, 0.035);
        transition:
          transform 0.3s ease,
          box-shadow 0.3s ease;
      }

      .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 32px rgba(36, 42, 33, 0.09);
      }

      .card-image {
        overflow: hidden;
        aspect-ratio: 4 / 3;
        background: #e5e5da;
      }

      .card-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
      }

      .card:hover .card-image img {
        transform: scale(1.04);
      }

      .card-content {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: flex-start;
        padding: 1.5rem;
      }

      .card-date {
        margin: 0 0 0.85rem;
        color: var(--sage);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .card h3 {
        margin: 0 0 0.8rem;
        color: var(--forest);
        font-family: var(--font-heading);
        font-size: clamp(1.35rem, 2vw, 1.7rem);
        font-weight: 500;
        line-height: 1.3;
      }

      .card-description {
        margin: 0;
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.8;
      }

      .card-link {
        margin-top: auto;
        padding-top: 1.5rem;
        color: var(--forest);
        font-size: 0.82rem;
        font-weight: 600;
      }

      .empty-state {
        padding: 3rem 1rem;
        border: 1px solid rgba(52, 59, 49, 0.12);
        color: var(--muted);
        text-align: center;
      }

      /* RESPONSIVE */

      @media (max-width: 900px) {
        .grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 1.75rem 1.25rem;
        }

        .wrap {
          padding: 4.5rem 1.5rem 5rem;
        }
      }

      @media (max-width: 600px) {
        .hero {
          min-height: 80svh;
          padding: 6rem 1.25rem;
        }

        .hero h1 {
          font-size: clamp(3rem, 13vw, 4.5rem);
        }

        .hero p {
          font-size: 1rem;
          line-height: 1.8;
        }

        .hero-note {
          right: 1rem;
          bottom: 1rem;
          font-size: 0.6rem;
        }

        .wrap {
          padding: 3.75rem 1.25rem 4.5rem;
        }

        .section-heading {
          align-items: flex-start;
          flex-direction: column;
          gap: 1rem;
          margin-bottom: 1.75rem;
        }

        .grid {
          grid-template-columns: minmax(0, 1fr);
          gap: 1.5rem;
        }

        .card-image {
          aspect-ratio: 5 / 3;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        :global(html) {
          scroll-behavior: auto;
        }

        .btn,
        .card,
        .card-image img {
          transition: none;
        }

        .btn:hover,
        .card:hover {
          transform: none;
        }

        .card:hover .card-image img {
          transform: none;
        }
      }




		/* Latest Adventures section */
		.latest-section {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 2rem 5rem;
		color: var(--forest, #343b31);
		}

		/* Section heading */
		.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
		}

		.section-heading h2 {
		margin: 0.35rem 0 0;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: clamp(2.2rem, 4vw, 3rem);
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.025em;
		}

		.section-label {
		margin: 0;
		color: var(--sage, #69715d);
		font-family: 'DM Sans', sans-serif;
		font-size: 0.75rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		}

		.all-stories-link {
		color: var(--forest, #343b31);
		font-family: 'DM Sans', sans-serif;
		font-size: 0.85rem;
		text-decoration: none;
		white-space: nowrap;
		}

		.all-stories-link:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
		}

		/* Featured story */
		.featured-story {
		padding-bottom: 1.75rem;
		border-bottom: 1px solid #deded3;
		}

		.featured-image,
		.gallery-image {
		display: block;
		width: 100%;
		overflow: hidden;
		border-radius: 17px;
		background: #e8e7df;
		}

		.featured-image {
		aspect-ratio: 16 / 7;
		}

		.featured-image img,
		.gallery-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 350ms ease;
		}

		.featured-image:hover img,
		.gallery-image:hover img {
		transform: scale(1.025);
		}

		.featured-details {
		position: relative;
		padding-top: 1rem;
		padding-right: 3.5rem;
		}

		.story-date {
		margin: 0 0 0.5rem;
		color: var(--sage, #69715d);
		font-family: 'DM Sans', sans-serif;
		font-size: 0.75rem;
		letter-spacing: 0.035em;
		text-transform: uppercase;
		}

		.featured-details h3,
		.gallery-details h3 {
		margin: 0 0 0.45rem;
		color: var(--forest, #343b31);
		font-family: 'Playfair Display', Georgia, serif;
		font-weight: 400;
		line-height: 1.3;
		}

		.featured-details h3 {
		font-size: clamp(1.65rem, 2.5vw, 2.1rem);
		}

		.story-description {
		margin: 0;
		color: var(--muted, #74766d);
		font-family: 'DM Sans', sans-serif;
		font-size: 0.9rem;
		line-height: 1.75;
		}

		.featured-arrow {
		position: absolute;
		top: 0.8rem;
		right: 0;
		display: grid;
		width: 2.5rem;
		height: 2.5rem;
		place-items: center;
		border: 1px solid #d0d0c3;
		border-radius: 50%;
		color: var(--forest, #343b31);
		text-decoration: none;
		font-size: 1.2rem;
		}

		/* Two-column story gallery */
		.story-gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 1rem;
		padding-top: 1.5rem;
		}

		.gallery-image {
		aspect-ratio: 4 / 3;
		}

		.gallery-details {
		padding-top: 0.5rem;
		}

		.gallery-details h3 {
		font-size: 1.3rem;
		}

		.story-link {
		display: inline-block;
		margin-top: 0.35rem;
		color: var(--forest, #343b31);
		font-family: 'DM Sans', sans-serif;
		font-size: 0.8rem;
		text-decoration: none;
		}

		.story-link:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
		}

		@media (max-width: 650px) {
		.latest-section {
			padding: 3rem 1.25rem;
		}

		.section-heading {
			align-items: start;
			flex-direction: column;
			gap: 0.75rem;
		}

		.featured-image {
			aspect-ratio: 4 / 3;
		}

		.story-gallery {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.gallery-image {
			aspect-ratio: 4 / 3;
		}
	}

		.editorial-date {
		margin-bottom: 0.5rem;
		}

		.gallery-details h3 {
		margin-top: 0;
		margin-bottom: 0.5rem;
		}

		.editorial-description {
		margin-top: 0;
		}


		/* Remove link underlines from story cards */
		.featured-story,
		.gallery-story {
		display: block;
		color: inherit;
		text-decoration: none;
		}

		.featured-story:hover,
		.gallery-story:hover {
		text-decoration: none;
		}

		.featured-story .editorial-description,
		.gallery-story .editorial-description {
		text-decoration: none;
		}

		/*scrolling behaviour */
		#latest-heading {
  		scroll-margin-top: 7rem;
		}

    </style>
  </head>

  <body>
    <Header />

    <section class="hero">
      <p class="eyebrow">Slow Down · Begin to Wander </p>

      <h1>{SITE_TITLE}</h1>

      <p>{SITE_DESCRIPTION}</p>

      
		<a class="btn" href="#latest-heading">
		Read the latest stories <span aria-hidden="true">↓</span>
		</a>


      <p class="hero-note">Stories from the road · Est. in adventure</p>
    </section>

    <main class="wrap">
      

		<section class="latest-section" aria-labelledby="latest-heading">
		<div class="section-heading">
			<div>
			<p class="section-label">NOTES FROM THE ROAD</p>
			<h2 id="latest-heading">Latest Adventures</h2>
			</div>

			<a class="all-stories" href="/blog">
			Explore all stories <span aria-hidden="true">↗</span>
			</a>
		</div>

		{latest.length > 0 ? (
			<>
			{/* Featured story */}
			<a class="featured-story" href={`/blog/${latest[0].id}/`}>
				<div class="featured-image">
				{latest[0].data.heroImage ? (
					<Image
					src={latest[0].data.heroImage}
					width={1600}
					height={900}
					quality={90}
					alt={latest[0].data.title}
					loading="eager"
					/>
				) : (
					<div class="editorial-placeholder" />
				)}
				</div>

				<div class="featured-details">
				<div class="featured-text">
					<p class="editorial-date">
					{latest[0].data.pubDate.toLocaleDateString('en', {
						month: 'long',
						day: 'numeric',
						year: 'numeric',
					})}
					</p>

					<h3>{latest[0].data.title}</h3>

					<p class="editorial-description">
					{latest[0].data.description}
					</p>
				</div>

				<span class="story-arrow" aria-label="Read story">↗</span>
				</div>
			</a>

			{/* Remaining stories */}
			{latest.length > 1 && (
				<div class="story-gallery">
				{latest.slice(1).map((post) => (
					<a class="gallery-story" href={`/blog/${post.id}/`}>
					<div class="gallery-image">
						{post.data.heroImage ? (
						<Image
							src={post.data.heroImage}
							width={1200}
							height={900}
							quality={90}
							alt={post.data.title}
							loading="lazy"
						/>
						) : (
						<div class="editorial-placeholder" />
						)}
					</div>

					<div class="gallery-details">
						<p class="editorial-date">
						{post.data.pubDate.toLocaleDateString('en', {
							month: 'long',
							year: 'numeric',
						})}
						</p>

						<h3>{post.data.title}</h3>

						<p class="editorial-description">
						{post.data.description}
						</p>

						<span class="gallery-link">
						Read story <span aria-hidden="true">↗</span>
						</span>
					</div>
					</a>
				))}
				</div>
			)}
			</>
		) : (
			<p class="empty-state">
			New adventures are on the way. Check back soon.
			</p>
		)}
		</section>


    </main>

    <Footer />
  </body>
</html>