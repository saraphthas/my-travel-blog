
---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PhotoScroll from '../components/PhotoScroll.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />

		<main>
			<article>
			
				<!-- Article heading -->
				<header class="article-header">
					<p class="article-label">NOTES FROM THE ROAD</p>

					<h1>{title}</h1>

					<div class="article-meta">
						<FormattedDate date={pubDate} />

						{updatedDate && (
							<span class="updated-date">
								· Updated <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>

					{description && (
						<p class="article-description">{description}</p>
					)}
				</header>

				<!-- Hero image -->
				{heroImage && (
					<div class="hero-image">
						<Image
							width={1200}
							height={675}
							src={heroImage}
							alt={title}
							loading="eager"
						/>
					</div>
				)}

				<!-- Blog post content from your Markdown file -->
				<div class="prose">
					<slot />
				</div>
			
			<PhotoScroll />
			</article>
			
		</main>
		
		<Footer />
	</body>
</html>

<style>
	:global(html) {
		background: #f4ede0;
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: #f4ede0;
		color: #292d27;
		font-family: 'DM Sans', sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	main {
		width: 100%;
		margin: 0 auto;
		padding: 0 24px 100px;
		box-sizing: border-box;
	}

	article {
		width: 100%;
		margin: 0 auto;
	}

	/* Article title and introduction */
	.article-header {
		max-width: 850px;
		margin: 0 auto;
		padding: 76px 0 42px;
		text-align: center;
	}

	.article-label {
		margin: 0 0 22px;
		color: #69715d;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.2em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		color: #343b31;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: clamp(42px, 6vw, 76px);
		font-weight: 500;
		letter-spacing: -0.045em;
		line-height: 1.08;
	}

	.article-meta {
		margin-top: 24px;
		color: #74766d;
		font-size: 12px;
		letter-spacing: 0.06em;
	}

	.updated-date {
		margin-left: 4px;
	}

	.article-description {
		max-width: 610px;
		margin: 24px auto 0;
		color: #62665a;
		font-size: 17px;
		line-height: 1.8;
	}

	/* Large rounded feature image */
	.hero-image {
		width: 100%;
		max-width: 1100px;
		margin: 0 auto;
		overflow: hidden;
		border-radius: 18px;
	}

	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 18px;
	}

	/* Article body */
	.prose {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 720px;
		margin: 0 auto;
		padding-top: 48px;
		color: #3e4139;
		font-size: 16px;
		line-height: 1.9;
	}

	/* These selectors style the Markdown inserted by <slot /> */
	.prose :global(p) {
		margin: 0 0 1.5em;
	}

	.prose :global(h2) {
		margin: 2.5em 0 0.8em;
		color: #343b31;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: clamp(27px, 3vw, 34px);
		font-weight: 500;
		letter-spacing: -0.025em;
		line-height: 1.25;
	}

	.prose :global(h3) {
		margin: 2em 0 0.7em;
		color: #343b31;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 23px;
		font-weight: 500;
		line-height: 1.35;
	}

	.prose :global(a) {
		color: #58664b;
		text-decoration-color: #a5ad98;
		text-underline-offset: 4px;
	}

	.prose :global(a:hover) {
		color: #343b31;
	}

	.prose :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin: 2.5em 0;
		border-radius: 16px;
	}

	.prose :global(figure) {
		margin: 2.5em 0;
	}

	.prose :global(figcaption) {
		margin-top: 10px;
		color: #74766d;
		font-size: 12px;
		text-align: center;
	}

	.prose :global(blockquote) {
		margin: 2em 0;
		padding: 4px 0 4px 22px;
		border-left: 2px solid #b7c4a5;
		color: #62665a;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 21px;
		font-style: italic;
		line-height: 1.7;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.5em;
		padding-left: 1.5em;
	}

	.prose :global(li) {
		margin-bottom: 0.5em;
	}

	.prose :global(hr) {
		margin: 3em auto;
		border: 0;
		border-top: 1px solid #d8d2c5;
	}

	/* Mobile layout */
	@media (max-width: 640px) {
		main {
			padding: 0 18px 64px;
		}

		.article-header {
			padding: 52px 0 30px;
		}

		.article-label {
			margin-bottom: 16px;
			font-size: 10px;
		}

		h1 {
			font-size: clamp(38px, 11vw, 54px);
		}

		.article-meta {
			margin-top: 18px;
			font-size: 11px;
		}

		.article-description {
			margin-top: 18px;
			font-size: 15px;
			line-height: 1.75;
		}

		.hero-image,
		.hero-image img {
			border-radius: 12px;
		}

		.prose {
			padding-top: 32px;
			font-size: 15px;
			line-height: 1.85;
		}

		.prose :global(h2) {
			margin-top: 2.2em;
		}

		.prose :global(img) {
			margin: 2em 0;
			border-radius: 12px;
		}
	}
</style>
